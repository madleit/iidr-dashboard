app:
  name: IIDR CDC Dashboard
  audit_log: logs/audit.jsonl

auth:
  # Se vazio, o V1 aceita o header X-User sem checar grupo local.
  # Em LAB pode deixar vazio. Em Linux real, coloque CDC ou cdc.
  required_group: ""

chcclp:
  java_bin: /usr/bin/java
  jar_path: /classic-chcclp/chcclp.jar
  timeout_seconds: 90

environments:
  LAB:
    host: 192.168.56.104
    port: 10101
    source_datastore: CDC_SRC
    target_datastore: CDC_TGT
